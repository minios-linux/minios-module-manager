#. type: Plain text
#: en/minios-module-manager.1:4
msgid "minios-module-manager - inspect, create and manage MiniOS modules"
msgstr "minios-module-manager - memeriksa, membuat, dan mengelola modul MiniOS"

#. type: SH
#: en/minios-module-manager.1:4
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSIS"

#. type: Plain text
#: en/minios-module-manager.1:7
msgid "B<minios-module-manager> [I<module-file>]"
msgstr "B<minios-module-manager> [I<module-file>]"

#. type: SH
