msgid "Inspect, create and manage MiniOS modules"
msgstr "Inspecciona, crea y gestiona módulos de MiniOS"

#: share/applications/minios-module-manager.desktop:22
msgid "module;sb;squashfs;bundle;"
msgstr "módulo;sb;squashfs;paquete;"

#~ msgid "The source folder is not modified and an existing output file is never overwritten. Ordinary conversion does not need administrator privileges. Inside the module, ordinary user and group IDs (1000–60000) become <b>root</b>, except within <tt>/home</tt> and <tt>/opt</tt>. System IDs are preserved. The module root and standard top-level directories, including <tt>/home</tt> and <tt>/opt</tt> themselves, become root:root. This cannot recover owners lost during unprivileged extraction. The new module is not loaded automatically."
#~ msgstr "La carpeta de origen no se modifica y un archivo de salida existente nunca se sobrescribe. La conversión ordinaria no requiere privilegios de administrador. Dentro del módulo, los IDs de usuario y grupo ordinarios (1000–60000) se convierten en <b>root</b>, excepto dentro de <tt>/home</tt> y <tt>/opt</tt>. Los IDs de sistema se conservan. La raíz del módulo y los directorios estándar de nivel superior, incluidos <tt>/home</tt> y <tt>/opt</tt> en sí mismos, pasan a ser root:root. Esto no puede recuperar propietarios perdidos durante una extracción sin privilegios. El nuevo módulo no se carga automáticamente."

#~ msgid "Source folder is not readable."
#~ msgstr "La carpeta de origen no es legible."

#~ msgid "The source folder is not modified. A new module is created rootlessly; an existing output is never replaced."
#~ msgstr "La carpeta de origen no se modifica. Se crea un nuevo módulo sin raíz; nunca se reemplaza una salida existente."
