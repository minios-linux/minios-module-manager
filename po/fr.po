#: lib/minios_module_manager/ui.py:44 lib/minios_module_manager/ui.py:2393
msgid "Installation Script"
msgstr "Script d'installation"

#: lib/minios_module_manager/ui.py:45
msgid "For repeatable setup that can be expressed as commands without interactive input."
msgstr "Pour une configuration reproductible pouvant être exprimée sous forme de commandes sans saisie interactive."

#: lib/minios_module_manager/ui.py:46 lib/minios_module_manager/ui.py:2647
msgid "Interactive Chroot"
msgstr "Chroot interactif"

#: lib/minios_module_manager/ui.py:47
msgid "For manual or interactive setup in a temporary root shell."
msgstr "Pour une configuration manuelle ou interactive dans un shell root temporaire."

#: lib/minios_module_manager/ui.py:48 lib/minios_module_manager/ui.py:1428
#: lib/minios_module_manager/ui.py:1819
msgid "Folder"
msgstr "Dossier"

#: lib/minios_module_manager/ui.py:49
msgid "For an already prepared filesystem tree that should become the module contents."
msgstr "Pour un arbre de fichiers déjà préparé qui doit devenir le contenu du module."

#: lib/minios_module_manager/ui.py:50 lib/minios_module_manager/ui.py:3071
msgid "Current Session Changes"
msgstr "Modifications de la session en cours"

#: lib/minios_module_manager/ui.py:51
msgid "For eligible changes that have already been made in this live session."
msgstr "Pour les modifications éligibles qui ont déjà été effectuées dans cette session live."

#: lib/minios_module_manager/ui.py:75
msgid "Install packages from repositories or local .deb files and save the result as a module."
msgstr "Installez des paquets depuis les dépôts ou des fichiers .deb locaux et enregistrez le résultat sous forme de module."

#: lib/minios_module_manager/ui.py:77 lib/minios_module_manager/ui.py:85
#: lib/minios_module_manager/ui.py:101 lib/minios_module_manager/ui.py:109
msgid "What to enter"
msgstr "Que saisir"

#: lib/minios_module_manager/ui.py:78
msgid ""
"• <b>Repository packages</b> — package names separated by spaces. Use <tt>↑</tt>/<tt>↓</tt> to choose a suggestion and <tt>Tab</tt> or <tt>Enter</tt> to accept it.\n"
"• <b>Local packages</b> — add <tt>.deb</tt> files from disk.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Paquets du dépôt</b> — noms de paquets séparés par des espaces. Utilisez <tt>↑</tt>/<tt>↓</tt> pour choisir une suggestion et <tt>Tab</tt> ou <tt>Entrée</tt> pour la valider.\n"
"• <b>Paquets locaux</b> — ajoutez des fichiers <tt>.deb</tt> depuis le disque.\n"
"• <b>Module de sortie</b> — sélectionnez le nouveau fichier <tt>.sb</tt>.\n"
"• <b>Compression</b> — laissez <tt>zstd</tt> sauf si vous avez besoin d’un autre format.\n"
"• <b>Niveau de base de construction</b> — choisissez le module actif numéroté le plus élevé à inclure ; tous les modules actifs numérotés jusqu’à celui-ci et tous les modules actifs non numérotés seront utilisés ensemble."

#: lib/minios_module_manager/ui.py:79 lib/minios_module_manager/ui.py:87
msgid "How it works"
msgstr "Fonctionnement"

#: lib/minios_module_manager/ui.py:80
msgid "APT installs the selected packages and their dependencies. MiniOS does not install recommended or suggested packages by default; enable the corresponding checkboxes to include them explicitly. Package installation runs with administrator privileges. The current MiniOS session is not changed, and the new module is not loaded automatically."
msgstr "APT installe les paquets sélectionnés ainsi que leurs dépendances. MiniOS n'installe pas par défaut les paquets recommandés ou suggérés ; cochez les cases correspondantes pour les inclure explicitement. L'installation des paquets s'effectue avec les privilèges administrateur. La session actuelle de MiniOS n'est pas modifiée, et le nouveau module n'est pas chargé automatiquement."

#: lib/minios_module_manager/ui.py:83
msgid "Run an installation script and save the changes it makes as a module."
msgstr "Exécutez un script d'installation et enregistrez les modifications apportées sous forme de module."

#: lib/minios_module_manager/ui.py:86
msgid ""
"• <b>Installation script</b> — the script that performs the installation or setup.\n"
"• <b>Seed folder</b> — optional files to copy into the module before the script runs.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Script d’installation</b> — le script qui effectue l’installation ou la configuration.\n"
"• <b>Dossier de semence</b> — fichiers optionnels à copier dans le module avant l’exécution du script.\n"
"• <b>Module de sortie</b> — sélectionnez le nouveau fichier <tt>.sb</tt>.\n"
"• <b>Compression</b> — laissez <tt>zstd</tt> sauf si vous avez besoin d’un autre format.\n"
"• <b>Niveau de base de construction</b> — choisissez le module actif numéroté le plus élevé à inclure ; tous les modules actifs numérotés jusqu’à celui-ci et tous les modules actifs non numérotés seront utilisés ensemble."

#: lib/minios_module_manager/ui.py:88
msgid "The script runs with administrator privileges and <b>without an interactive terminal</b>. If it asks questions or needs manual work, use <b>Interactive Chroot</b> instead. The script itself is not stored in the module. The current MiniOS session is not changed."
msgstr "Le script s'exécute avec les droits administrateur et <b>sans terminal interactif</b>. S'il pose des questions ou nécessite une intervention manuelle, utilisez plutôt <b>Chroot interactif</b>. Le script lui-même n'est pas stocké dans le module. La session MiniOS en cours n'est pas modifiée."

#: lib/minios_module_manager/ui.py:91
msgid "Open a temporary MiniOS system in a terminal and save your changes as a module."
msgstr "Ouvrez un système MiniOS temporaire dans un terminal et enregistrez vos modifications sous forme de module."

#: lib/minios_module_manager/ui.py:93
msgid "Before you start"
msgstr "Avant de commencer"

#: lib/minios_module_manager/ui.py:94
msgid ""
"• <b>Seed folder</b> — optional files to copy into the temporary system before the shell opens.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Dossier de semence</b> — fichiers optionnels à copier dans le système temporaire avant l’ouverture du shell.\n"
"• <b>Module de sortie</b> — sélectionnez le nouveau fichier <tt>.sb</tt>.\n"
"• <b>Compression</b> — laissez <tt>zstd</tt> sauf si vous avez besoin d’un autre format.\n"
"• <b>Niveau de base de construction</b> — choisissez le module actif numéroté le plus élevé à inclure ; tous les modules actifs numérotés jusqu’à celui-ci et tous les modules actifs non numérotés seront utilisés ensemble."

#: lib/minios_module_manager/ui.py:95
msgid "How to finish"
msgstr "Comment terminer"

#: lib/minios_module_manager/ui.py:96
msgid "Work in the terminal as <b>root</b>. When you are finished, type <tt>exit</tt>. Then choose <b>Create Module</b> to save the changes, <b>Reopen Shell</b> to continue working, or <b>Discard Changes</b> to cancel. The current MiniOS session is not changed."
msgstr "Travaillez dans le terminal en tant que <b>root</b>. Lorsque vous avez terminé, tapez <tt>exit</tt>. Ensuite, choisissez <b>Créer le module</b> pour enregistrer les modifications, <b>Rouvrir le shell</b> pour continuer, ou <b>Annuler les modifications</b> pour abandonner. La session MiniOS en cours n'est pas modifiée."

#: lib/minios_module_manager/ui.py:99
msgid "Convert the contents of a folder directly into a compressed .sb module."
msgstr "Convertissez le contenu d’un dossier directement en un module compressé .sb."

#: lib/minios_module_manager/ui.py:102
msgid ""
"• <b>Source folder</b> — its contents become the root of the module. The source folder name itself is not added.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format."
msgstr ""
"• <b>Dossier source</b> — son contenu devient la racine du module. Le nom du dossier source n’est pas inclus.\n"
"• <b>Module de sortie</b> — choisissez le nouveau fichier <tt>.sb</tt>.\n"
"• <b>Compression</b> — laissez <tt>zstd</tt> sauf si vous avez besoin d’un autre format."

#: lib/minios_module_manager/ui.py:103
msgid "Result"
msgstr "Résultat"

#: lib/minios_module_manager/ui.py:104
msgid "The source folder is not modified and an existing output file is never overwritten. Ordinary conversion does not need administrator privileges. File ownership inside the module is normalized to <b>root</b>. The new module is not loaded automatically."
msgstr "Le dossier source n’est pas modifié et un fichier de sortie existant n’est jamais écrasé. Une conversion classique ne nécessite pas de privilèges administrateur. La propriété des fichiers dans le module est normalisée à <b>root</b>. Le nouveau module n’est pas chargé automatiquement."

#: lib/minios_module_manager/ui.py:107
msgid "Save changes already made in the current MiniOS session as a module."
msgstr "Enregistrez les modifications déjà effectuées dans la session MiniOS en cours sous forme de module."

#: lib/minios_module_manager/ui.py:110
msgid ""
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"MiniOS finds the current session changes automatically."
msgstr ""
"• <b>Module de sortie</b> — choisissez le nouveau fichier <tt>.sb</tt>.\n"
"• <b>Compression</b> — laissez <tt>zstd</tt> sauf si vous avez besoin d’un autre format.\n"
"MiniOS détecte automatiquement les modifications de la session en cours."

#: lib/minios_module_manager/ui.py:111
msgid "What is saved"
msgstr "Ce qui est sauvegardé"

#: lib/minios_module_manager/ui.py:112
msgid "Files and configuration changes from the current session are saved, including supported file deletions. Logs, caches, boot data and temporary runtime files are skipped by the standard MiniOS save policy. Reading all session changes requires administrator privileges. The current session is not modified."
msgstr "Les fichiers et modifications de configuration de la session en cours sont sauvegardés, y compris les suppressions de fichiers prises en charge. Les journaux, caches, données de démarrage et fichiers temporaires d’exécution sont ignorés selon la politique standard de sauvegarde MiniOS. La lecture de toutes les modifications de session nécessite des privilèges administrateur. La session en cours n’est pas modifiée."

