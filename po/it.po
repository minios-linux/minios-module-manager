#: share/applications/minios-module-manager.desktop:22
msgid "module;sb;squashfs;bundle;"
msgstr "modulo;sb;squashfs;bundle;"

#~ msgid "The source folder is not modified and an existing output file is never overwritten. Ordinary conversion does not need administrator privileges. Inside the module, ordinary user and group IDs (1000–60000) become <b>root</b>, except within <tt>/home</tt> and <tt>/opt</tt>. System IDs are preserved. The module root and standard top-level directories, including <tt>/home</tt> and <tt>/opt</tt> themselves, become root:root. This cannot recover owners lost during unprivileged extraction. The new module is not loaded automatically."
#~ msgstr "La cartella sorgente non viene modificata e un file di output esistente non viene mai sovrascritto. La conversione ordinaria non richiede privilegi di amministratore. All'interno del modulo, gli ID utente e gruppo ordinari (1000–60000) diventano <b>root</b>, tranne che in <tt>/home</tt> e <tt>/opt</tt>. Gli ID di sistema vengono mantenuti. La root del modulo e le directory principali standard, inclusi <tt>/home</tt> e <tt>/opt</tt> stessi, diventano root:root. Questa operazione non può recuperare i proprietari persi durante l'estrazione senza privilegi. Il nuovo modulo non viene caricato automaticamente."

#~ msgid "Source folder is not readable."
#~ msgstr "La cartella di origine non è leggibile."

#~ msgid "The source folder is not modified. A new module is created rootlessly; an existing output is never replaced."
#~ msgstr "La cartella di origine non viene modificata. Un nuovo modulo viene creato senza privilegi di root; un output esistente non viene mai sovrascritto."
