msgstr "Отмена…"

#: lib/minios_module_manager/ui.py:160
msgid "Preparing extraction…"
msgstr "Подготовка к извлечению…"

#: lib/minios_module_manager/ui.py:161
msgid "Extracting module…"
msgstr "Извлечение модуля…"

#: lib/minios_module_manager/ui.py:162
msgid "Publishing extracted files…"
msgstr "Публикация извлечённых файлов…"

#: lib/minios_module_manager/ui.py:163 lib/minios_module_manager/ui.py:2018
