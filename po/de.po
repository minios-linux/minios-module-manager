#: lib/minios_module_manager/ui.py:43 lib/minios_module_manager/ui.py:2050
msgid "Packages"
msgstr "Pakete"

#: lib/minios_module_manager/ui.py:44
msgid "For software from APT repositories or local .deb packages; dependencies are installed automatically."
msgstr "Für Software aus APT-Repositories oder lokale .deb-Pakete; Abhängigkeiten werden automatisch installiert."

#: lib/minios_module_manager/ui.py:45 lib/minios_module_manager/ui.py:2394
msgid "Installation Script"
msgstr "Installationsskript"

#: lib/minios_module_manager/ui.py:46
msgid "For repeatable setup that can be expressed as commands without interactive input."
msgstr "Für wiederholbare Setups, die als Befehle ohne interaktive Eingaben ausgeführt werden können."

#: lib/minios_module_manager/ui.py:47 lib/minios_module_manager/ui.py:2648
msgid "Interactive Chroot"
msgstr "Interaktives Chroot"

#: lib/minios_module_manager/ui.py:48
msgid "For manual or interactive setup in a temporary root shell."
msgstr "Für manuelle oder interaktive Einrichtung in einer temporären Root-Shell."

#: lib/minios_module_manager/ui.py:49 lib/minios_module_manager/ui.py:1429
#: lib/minios_module_manager/ui.py:1820
msgid "Folder"
msgstr "Ordner"

#: lib/minios_module_manager/ui.py:50
msgid "For an already prepared filesystem tree that should become the module contents."
msgstr "Für einen bereits vorbereiteten Dateisystembaum, der als Modulinhalt verwendet werden soll."

#: lib/minios_module_manager/ui.py:51 lib/minios_module_manager/ui.py:3072
msgid "Current Session Changes"
msgstr "Aktuelle Sitzungsänderungen"

#: lib/minios_module_manager/ui.py:52
msgid "For eligible changes that have already been made in this live session."
msgstr "Für berechtigte Änderungen, die bereits in dieser Live-Sitzung vorgenommen wurden."

#: lib/minios_module_manager/ui.py:76
msgid "Install packages from repositories or local .deb files and save the result as a module."
msgstr "Pakete aus Repositories oder lokalen .deb-Dateien installieren und das Ergebnis als Modul speichern."

#: lib/minios_module_manager/ui.py:78 lib/minios_module_manager/ui.py:86
#: lib/minios_module_manager/ui.py:102 lib/minios_module_manager/ui.py:110
msgid "What to enter"
msgstr "Was eingeben"

#: lib/minios_module_manager/ui.py:79
msgid ""
"• <b>Repository packages</b> — package names separated by spaces. Use <tt>↑</tt>/<tt>↓</tt> to choose a suggestion and <tt>Tab</tt> or <tt>Enter</tt> to accept it.\n"
"• <b>Local packages</b> — add <tt>.deb</tt> files from disk.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Repository-Pakete</b> — Paketnamen durch Leerzeichen getrennt. Mit <tt>↑</tt>/<tt>↓</tt> eine Vorschlag auswählen und mit <tt>Tab</tt> oder <tt>Enter</tt> übernehmen.\n"
"• <b>Lokale Pakete</b> — <tt>.deb</tt>-Dateien von der Festplatte hinzufügen.\n"
"• <b>Ausgabemodul</b> — die neue <tt>.sb</tt>-Datei auswählen.\n"
"• <b>Komprimierung</b> — belassen Sie <tt>zstd</tt>, sofern kein anderes Format benötigt wird.\n"
"• <b>Build-Basisstufe</b> — das aktivierte Modul mit der höchsten Nummer auswählen; alle aktiven nummerierten Module bis dahin sowie alle aktiven unnummerierten Module werden gemeinsam verwendet."

#: lib/minios_module_manager/ui.py:80 lib/minios_module_manager/ui.py:88
msgid "How it works"
msgstr "Funktionsweise"

#: lib/minios_module_manager/ui.py:81
msgid "APT installs the selected packages and their dependencies. MiniOS does not install recommended or suggested packages by default; enable the corresponding checkboxes to include them explicitly. Package installation runs with administrator privileges. The current MiniOS session is not changed, and the new module is not loaded automatically."
msgstr "APT installiert die ausgewählten Pakete und deren Abhängigkeiten. MiniOS installiert standardmäßig keine empfohlenen oder vorgeschlagenen Pakete; aktivieren Sie die entsprechenden Kontrollkästchen, um sie explizit einzuschließen. Die Paketinstallation erfolgt mit Administratorrechten. Die aktuelle MiniOS-Sitzung wird nicht verändert und das neue Modul wird nicht automatisch geladen."

#: lib/minios_module_manager/ui.py:84
msgid "Run an installation script and save the changes it makes as a module."
msgstr "Ein Installationsskript ausführen und die vorgenommenen Änderungen als Modul speichern."

#: lib/minios_module_manager/ui.py:87
msgid ""
"• <b>Installation script</b> — the script that performs the installation or setup.\n"
"• <b>Seed folder</b> — optional files to copy into the module before the script runs.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Installationsskript</b> — das Skript, das die Installation oder Einrichtung durchführt.\n"
"• <b>Seed-Ordner</b> — optionale Dateien, die vor dem Skript in das Modul kopiert werden.\n"
"• <b>Ausgabemodul</b> — die neue <tt>.sb</tt>-Datei auswählen.\n"
"• <b>Komprimierung</b> — belassen Sie <tt>zstd</tt>, sofern kein anderes Format benötigt wird.\n"
"• <b>Build-Basisstufe</b> — das aktivierte Modul mit der höchsten Nummer auswählen; alle aktiven nummerierten Module bis dahin sowie alle aktiven unnummerierten Module werden gemeinsam verwendet."

#: lib/minios_module_manager/ui.py:89
msgid "The script runs with administrator privileges and <b>without an interactive terminal</b>. If it asks questions or needs manual work, use <b>Interactive Chroot</b> instead. The script itself is not stored in the module. The current MiniOS session is not changed."
msgstr "Das Skript läuft mit Administratorrechten und <b>ohne interaktives Terminal</b>. Wenn es Rückfragen stellt oder manuelle Eingaben benötigt, verwenden Sie stattdessen <b>Interaktives Chroot</b>. Das Skript selbst wird nicht im Modul gespeichert. Die aktuelle MiniOS-Sitzung bleibt unverändert."

#: lib/minios_module_manager/ui.py:92
msgid "Open a temporary MiniOS system in a terminal and save your changes as a module."
msgstr "Ein temporäres MiniOS-System im Terminal öffnen und Ihre Änderungen als Modul speichern."

#: lib/minios_module_manager/ui.py:94
msgid "Before you start"
msgstr "Bevor Sie beginnen"

#: lib/minios_module_manager/ui.py:95
msgid ""
"• <b>Seed folder</b> — optional files to copy into the temporary system before the shell opens.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"• <b>Build base level</b> — choose the highest numbered active module to include; all active numbered modules up to it and all active unnumbered modules are used together."
msgstr ""
"• <b>Seed-Ordner</b> — optionale Dateien, die vor dem Öffnen der Shell in das temporäre System kopiert werden.\n"
"• <b>Ausgabemodul</b> — die neue <tt>.sb</tt>-Datei auswählen.\n"
"• <b>Komprimierung</b> — belassen Sie <tt>zstd</tt>, sofern kein anderes Format benötigt wird.\n"
"• <b>Build-Basisstufe</b> — das aktivierte Modul mit der höchsten Nummer auswählen; alle aktiven nummerierten Module bis dahin sowie alle aktiven unnummerierten Module werden gemeinsam verwendet."

#: lib/minios_module_manager/ui.py:96
msgid "How to finish"
msgstr "So beenden Sie"

#: lib/minios_module_manager/ui.py:97
msgid "Work in the terminal as <b>root</b>. When you are finished, type <tt>exit</tt>. Then choose <b>Create Module</b> to save the changes, <b>Reopen Shell</b> to continue working, or <b>Discard Changes</b> to cancel. The current MiniOS session is not changed."
msgstr "Arbeiten Sie im Terminal als <b>root</b>. Wenn Sie fertig sind, geben Sie <tt>exit</tt> ein. Wählen Sie anschließend <b>Modul erstellen</b>, um die Änderungen zu speichern, <b>Shell erneut öffnen</b>, um weiterzuarbeiten, oder <b>Änderungen verwerfen</b>, um abzubrechen. Die aktuelle MiniOS-Sitzung bleibt unverändert."

#: lib/minios_module_manager/ui.py:100
msgid "Convert the contents of a folder directly into a compressed .sb module."
msgstr "Den Inhalt eines Ordners direkt in ein komprimiertes .sb-Modul umwandeln."

#: lib/minios_module_manager/ui.py:103
msgid ""
"• <b>Source folder</b> — its contents become the root of the module. The source folder name itself is not added.\n"
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format."
msgstr ""
"• <b>Quellordner</b> — dessen Inhalt wird zum Wurzelverzeichnis des Moduls. Der Name des Quellordners selbst wird nicht übernommen.\n"
"• <b>Ausgabemodul</b> — wählen Sie die neue <tt>.sb</tt>-Datei aus.\n"
"• <b>Komprimierung</b> — belassen Sie <tt>zstd</tt>, sofern Sie kein anderes Format benötigen."

#: lib/minios_module_manager/ui.py:104
msgid "Result"
msgstr "Ergebnis"

#: lib/minios_module_manager/ui.py:105
msgid "The source folder is not modified and an existing output file is never overwritten. Ordinary conversion does not need administrator privileges. File ownership inside the module is normalized to <b>root</b>. The new module is not loaded automatically."
msgstr "Der Quellordner wird nicht verändert und eine vorhandene Ausgabedatei niemals überschrieben. Für eine normale Umwandlung sind keine Administratorrechte erforderlich. Die Dateibesitzrechte im Modul werden auf <b>root</b> normalisiert. Das neue Modul wird nicht automatisch geladen."

#: lib/minios_module_manager/ui.py:108
msgid "Save changes already made in the current MiniOS session as a module."
msgstr "Bereits in der aktuellen MiniOS-Sitzung vorgenommene Änderungen als Modul speichern."

#: lib/minios_module_manager/ui.py:111
msgid ""
"• <b>Output module</b> — choose the new <tt>.sb</tt> file.\n"
"• <b>Compression</b> — leave <tt>zstd</tt> unless you need another format.\n"
"MiniOS finds the current session changes automatically."
msgstr ""
"• <b>Ausgabemodul</b> — wählen Sie die neue <tt>.sb</tt>-Datei aus.\n"
"• <b>Komprimierung</b> — belassen Sie <tt>zstd</tt>, sofern Sie kein anderes Format benötigen.\n"
"MiniOS erkennt die Änderungen der aktuellen Sitzung automatisch."

#: lib/minios_module_manager/ui.py:112
msgid "What is saved"
msgstr "Was gespeichert wird"

#: lib/minios_module_manager/ui.py:113
msgid "Files and configuration changes from the current session are saved, including supported file deletions. Logs, caches, boot data and temporary runtime files are skipped by the standard MiniOS save policy. Reading all session changes requires administrator privileges. The current session is not modified."
msgstr "Dateien und Konfigurationsänderungen aus der aktuellen Sitzung werden gespeichert, einschließlich unterstützter Dateilöschungen. Protokolle, Caches, Bootdaten und temporäre Laufzeitdateien werden gemäß der Standard-Speicherregel von MiniOS übersprungen. Das Lesen aller Sitzungsänderungen erfordert Administratorrechte. Die aktuelle Sitzung wird nicht verändert."

#: lib/minios_module_manager/ui.py:128
msgid "Extract Module"
msgstr "Modul extrahieren"

