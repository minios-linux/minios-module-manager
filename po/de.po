msgstr "Die aktuellen Bootmodul-Regeln von MiniOS werden angewendet."

#: lib/minios_module_manager/ui.py:956
msgid "Module Details"
msgstr "Modul-Details"

#: lib/minios_module_manager/ui.py:971 lib/minios_module_manager/ui.py:974
#: lib/minios_module_manager/ui.py:1605
msgid "Delete Module"
msgstr "Modul löschen"

#: lib/minios_module_manager/ui.py:982 lib/minios_module_manager/ui.py:983
msgid "Extract to Folder…"
msgstr "In Ordner extrahieren…"

#: lib/minios_module_manager/ui.py:1008
msgid "Search module contents…"
msgstr "Modulinhalte durchsuchen…"

#: lib/minios_module_manager/ui.py:1029
msgid "Name"
msgstr "Name"

#: lib/minios_module_manager/ui.py:1039
msgid "Type"
msgstr "Typ"

#: lib/minios_module_manager/ui.py:1045 lib/minios_module_manager/ui.py:2054
